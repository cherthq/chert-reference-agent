# Synthetic documentation only. Real credentials come from the chosen host's
# protected environment; this service never loads dotenv files automatically.
# Default: match Chert's unchecked "Enable webhook signing" checkbox.
CHERT_SIGNING_ENABLED=false
CHERT_WEBHOOK_ROUTES_JSON={"/webhooks/reference":{}}
# Signed alternative (set BOTH, and enable signing in Chert):
# CHERT_SIGNING_ENABLED=true
# CHERT_WEBHOOK_ROUTES_JSON={"/webhooks/reference":{"1":"replace-with-signing-secret"}}
# Existing signed deployments MUST explicitly set true before upgrading.
LIVEKIT_URL=wss://project.example.test
LIVEKIT_API_KEY=replace-with-project-key
LIVEKIT_API_SECRET=replace-with-project-secret
CHERT_NAMESPACE=reference
CHERT_JOURNAL_PATH=/state/rooms.json
CHERT_DECISION_BUDGET_MS=4000
CHERT_TOKEN_TTL_SECONDS=3600
CHERT_RESOURCE_TTL_SECONDS=1800
CHERT_WORKER_ARRIVAL_TIMEOUT_SECONDS=30
CHERT_WATCH_INTERVAL_SECONDS=1
CHERT_STALL_TIMEOUT_SECONDS=10
CHERT_CLEANUP_TIMEOUT_SECONDS=5
CHERT_CLEANUP_ATTEMPTS=3
CHERT_CAPACITY=100
CHERT_SOURCE_SHA=local-unreleased
CHERT_IMAGE_DIGEST=not-built
CHERT_CONFIG_REVISION=example-v1
BIND_HOST=127.0.0.1
PORT=8080
